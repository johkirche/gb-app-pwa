# Production build configuration — committed on purpose. NEVER put secrets here:
# every VITE_* value is inlined verbatim into the public JS bundle.
VITE_BACKEND_URL=https://gb26-admin.johannische-kirche.org
VITE_SHOW_DEV_SKIP=false

# Temporarily shipped in production: floating button (desktop widths only) that
# opens the current route in a 390x844 iframe, so phone layout can be checked on
# the deployed site. Set to false to drop the button and its chunk again.
VITE_SHOW_VIEWPORT_PREVIEW=true
