# Backend Configuration
VITE_BACKEND_URL=https://your-directus-instance.com

# NOTE: There is intentionally no static API token here. Authentication is done
# entirely through the user's own Directus login session (access + refresh token).
# Anything put into a VITE_* variable is inlined verbatim into the built JS and is
# readable by anyone who loads the site, so it must never hold a secret.

# Development Features
# Set to 'true' to show the "Skip (Development Mode)" button on login/register pages.
# The button additionally requires a dev build (import.meta.env.DEV) and is inert in
# production builds regardless of this flag; the bypass is in-memory only and never
# persisted. Must stay 'false' for anything that gets deployed.
VITE_SHOW_DEV_SKIP=false

# Set to 'true' to show the mobile-viewport preview button (a floating phone icon
# on desktop widths that opens the current route in a 390x844 iframe). Always on
# in dev builds regardless of this flag; in production builds the button and its
# chunk only ship when this is 'true'. It is visible to every visitor, so treat
# it as a temporary aid, not a default.
VITE_SHOW_VIEWPORT_PREVIEW=false

# Set to 'true' to keep the Akzent on the reader's Directus profile, so it follows
# them to another device. Needs a string field `akzent` on directus_users that the
# member policy may read and update (own row only); leave 'false' until it exists.
VITE_AKZENT_PROFIL=false

# End-to-end test recording (`pnpm test:e2e:record`) — optional, local only.
# Deliberately NOT VITE_ prefixed: a VITE_ variable is inlined verbatim into the
# built JS and readable by anyone who loads the site. These are read by
# playwright.config.ts in Node, never by the app, and never reach the bundle.
# Only the recording run uses them; `pnpm test:e2e` replays a stubbed login.
E2E_DIRECTUS_EMAIL=
E2E_DIRECTUS_PASSWORD=

# The demo link (/demo/<key>, served by worker/demo.ts) — optional, local only.
# Not VITE_ prefixed, for the same reason: the dev server hands them to the
# Worker's handler in Node, and they never reach the bundle. In production they
# are Worker secrets (`wrangler secret put DEMO_KEY`, `… DEMO_DIRECTUS_TOKEN`).
# DEMO_DIRECTUS_TOKEN is a read-only static token: the settings singleton, the
# songs and their files. DIRECTUS_URL falls back to VITE_BACKEND_URL.
DEMO_KEY=
DEMO_DIRECTUS_TOKEN=
DEMO_UNTIL=
