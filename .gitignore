# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

# Environment variables (.env.production is committed on purpose — public values only)
.env
.env.local
.env.staging

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

dev-dist/
# Private, non-public documents (legal question catalogs etc.) - never commit
docs/private/

# Local reference copy of the printed book (~45 MB) - never commit
tests/assets/2026-08-05_gesangbuch_innenteil_choräle_1.pdf
