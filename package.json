{
    "name": "johannische-kirche-gesangbuch",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "build": "vue-tsc && vite build",
        "build:prod": "cross-env NODE_ENV=production vue-tsc && vite build",
        "preview": "vite preview",
        "generate:icons": "node scripts/generate-icons.mjs",
        "test:e2e": "cypress run",
        "test:unit": "vitest",
        "lint": "eslint .",
        "format": "prettier --write src/ --ignore-path dist/",
        "deploy": "pnpm run build:prod && wrangler pages deploy dist",
        "deploy:staging": "cross-env NODE_ENV=staging pnpm run build && wrangler pages deploy dist --branch staging",
        "wrangler:dev": "wrangler pages dev dist"
    },
    "dependencies": {
        "@capacitor/app": "8.1.0",
        "@capacitor/core": "8.3.4",
        "@capacitor/haptics": "8.0.2",
        "@capacitor/keyboard": "8.0.3",
        "@capacitor/status-bar": "8.0.2",
        "@directus/sdk": "^21.3.0",
        "@fontsource-variable/albert-sans": "^5.3.0",
        "@fontsource/cormorant-garamond": "^5.3.0",
        "@ionic/vue": "^8.8.8",
        "@ionic/vue-router": "^8.8.8",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dexie": "^4.4.3",
        "graphql": "^16.14.0",
        "ionicons": "^8.0.13",
        "lucide-vue-next": "^1.0.0",
        "opensheetmusicdisplay": "^1.9.9",
        "osmd-audio-player": "^0.7.0",
        "pinia": "^3.0.4",
        "reka-ui": "^2.10.3",
        "soundfont-player": "0.12.0",
        "standardized-audio-context": "^24.1.26",
        "tailwind-merge": "^3.6.0",
        "vaul-vue": "^0.4.1",
        "vue": "^3.5.35",
        "vue-draggable-plus": "^0.6.1",
        "vue-router": "^5.1.0",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@capacitor/cli": "8.3.4",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@vitejs/plugin-legacy": "^8.0.2",
        "@vitejs/plugin-vue": "^6.0.3",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/test-utils": "^2.4.10",
        "cross-env": "^10.1.0",
        "cypress": "^15.16.0",
        "eslint": "^10.0.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-prettier-vue": "^5.0.0",
        "eslint-plugin-vue": "^10.9.1",
        "globals": "^17.6.0",
        "jsdom": "^29.1.1",
        "png-to-ico": "^3.0.1",
        "prettier": "^3.8.3",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.3.3",
        "terser": "^5.48.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.0",
        "vite": "^8.0.14",
        "vite-plugin-pwa": "^1.3.0",
        "vite-plugin-vue-devtools": "^8.1.2",
        "vitest": "^4.1.7",
        "vue-eslint-parser": "^10.4.0",
        "vue-tsc": "^3.3.2",
        "workbox-window": "^7.4.0",
        "wrangler": "^4.95.0"
    },
    "description": "An Ionic project"
}
